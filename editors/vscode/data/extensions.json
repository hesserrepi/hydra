        "await loadScript(\"https://cdn.jsdelivr.net/gh/geikha/hyper-hydra@latest/hydra-abbreviations.js\")\n\no(10, 0.1, 1.2).bl(ns(3)).df(sh(4, 0.6).rt(0, 0.1)).out()"
      ],
      "autoload": false,
      "provides": {}
    },
    {
      "id": "extra-shaders/color",
      "collection": "extra-shaders",
      "name": "Color manipulation",
      "author": "Thomas Jourdan",
      "documentation": "https://gitlab.com/metagrowing/extra-shaders-for-hydra/-/blob/main/gallery/color/README.md",
      "description": "Color filters: sepia, levels, monotone, gradients, hsvshift and vector-math color mixing.",
      "examples": [
        "osc(4, 0.1, 1.2)\n  .levels(4, 0.8)\n  .out(o0)\ngradient(1).hsvshift(() => time % 1, 1, 1).out(o1)\nnoise(3).monotone(3, 0.6, 1).out(o2)\nvoronoi(5).grarose(1).out(o3)\nrender()"
