    {
      "id": "hyper-hydra/tap",
      "collection": "hyper-hydra",
      "name": "hydra-tap",
      "author": "geikha",
      "documentation": "https://github.com/geikha/hyper-hydra/blob/main/doc/hydra-tap.md",
      "description": "Tap tempo and beat envelopes (beats, beats_). Ctrl+Space+Shift pauses, Ctrl+Shift+number sets speed.",
      "examples": [
        "osc(30,.01,beats(1)).out()\n\n// Ctrl + Space Bar for tapping\n// Ctrl + , (Comma) for re-sync"
      ],
      "autoload": true,
      "provides": {
        "globals": [
          "beats",
          "beats_",
          "beatsTri",
          "beatsTri_",
          "hydraTap"
        ]
      }
    },
    {
      "id": "hyper-hydra/text",
      "collection": "hyper-hydra",
      "name": "hydra-text",
      "author": "geikha",
      "documentation": "https://github.com/geikha/hyper-hydra/blob/main/doc/hydra-text.md",
      "description": "Text as a hydra source: text(), strokeText(), fillStrokeText().",
      "examples": [
        "hydraText.font = \"serif\"\nhydraText.lineWidth = \"2%\"\nstr = \" hydra_! \"\nsolid(1,.2)\n  .blend(src(o0).scale(1.02).colorama(.02))\n  .layer(text(str))\n  .diff(strokeText(str).modulateScale(noise(1,1), .4))\n  .out()"
      ],
      "autoload": true,
      "provides": {
        "globals": [
          "text",
          "strokeText",
          "fillStrokeText",
          "strokeFillText",
          "createText",
          "hydraText"
        ]
      }
    },
    {
      "id": "hyper-hydra/vec4",
      "collection": "hyper-hydra",
      "name": "hydra-vec4",
      "author": "geikha",
      "documentation": "https://github.com/geikha/hyper-hydra/blob/main/doc/hydra-vec4.md",
      "description": "Construct colors like GLSL's vec4(), vec3() and vec2().",
      "examples": [
        "noise()\n  .mult(vec4(vec3(0.5), 1))\n  .add(vec4([0.5,0].smooth()))\n  .layer(vec4(vec3([0, 1, 0.5], vec2(()=>time%1)), 1).mask(shape(4)))\n  .out()"
      ],
      "autoload": true,
      "provides": {
        "globals": [
          "vec4",
          "vec3",
          "vec2"
        ]
      }
    },
    {
      "id": "hyper-hydra/wrap",
      "collection": "hyper-hydra",
      "name": "hydra-wrap",
      "author": "geikha",
      "documentation": "https://github.com/geikha/hyper-hydra/blob/main/doc/hydra-wrap.md",
      "description": "Change how textures wrap (mirror, repeat, clamp) with hydraWrap. Redefines src, scroll and related functions.",
      "examples": [
        "hydraWrap.setMirror()\n\nsrc(o0)\n  .layer(osc().rotate().mask(shape(4,1,0)))\n  .scale(.5)\n  .blend(noise(),.2)\n  .out()"
      ],
      "autoload": true,
      "provides": {
        "globals": [
          "hydraWrap"
        ]
      }
    },
    {
      "id": "hyper-hydra/abbreviations",
      "collection": "hyper-hydra",
      "name": "hydra-abbreviations",
      "author": "geikha",
      "documentation": "https://github.com/geikha/hyper-hydra#hydra-abbreviations",
      "description": "Write very small hydra code: o(), ns(), sh(), .bl(), .df()... Add it with + to use it.",
